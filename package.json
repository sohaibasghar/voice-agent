{
  "name": "voice-agent",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run shared:build && npm run backend:dev & npm run frontend:dev",

    "shared:build": "npm run build -w voice-agent-shared",

    "backend:dev": "npm run start:dev -w @voice-agent/backend",
    "backend:build": "npm run shared:build && npm run build -w @voice-agent/backend",
    "backend:start": "node backend/dist/main",

    "frontend:dev": "npm run dev -w @voice-agent/frontend",
    "frontend:build": "npm run shared:build && npm run build -w @voice-agent/frontend",

    "db:generate": "npm run prisma:generate -w @voice-agent/backend",
    "db:migrate": "npm run prisma:migrate -w @voice-agent/backend",
    "db:seed": "npm run seed -w @voice-agent/backend"
  }
}
