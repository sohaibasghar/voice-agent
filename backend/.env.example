# ── BACKEND (NestJS) ─────────────────────────────────────────────────────────
# Domain preset to load (see src/domain/presets/ for available options)
DOMAIN_PRESET=beauty-salon

# OpenAI API key — never expose to the browser
OPENAI_API_KEY=sk-proj-...

# dev → cheaper/faster model, live → high-quality model
MODEL_TIER=dev

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/voice_agent

# NestJS HTTP port
PORT=3000

# Business hours config (used by availability engine)
BUSINESS_HOURS=09:00-18:00
BUSINESS_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
SLOT_STEP_MIN=15
