# Backend env — real secrets stay here, never shipped to the browser (Constitution I)
OPENAI_API_KEY=sk-REPLACE_ME
# Domain preset to load (see backend/src/domain/presets/)
DOMAIN_PRESET=beauty-salon
# dev → cheap model (gpt-realtime-mini), live → high-quality (gpt-realtime-2)
MODEL_TIER=dev
# PostgreSQL connection string
DATABASE_URL=postgresql://USER@localhost:5432/voice_agent
PORT=3000
# Fixed business hours used to derive availability (research.md D8)
BUSINESS_HOURS=09:00-18:00
BUSINESS_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
SLOT_STEP_MIN=15
# IANA timezone for caller-facing times (unset → server timezone)
BUSINESS_TZ=Asia/Karachi
