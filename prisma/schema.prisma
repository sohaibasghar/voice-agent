// Voice Front-Desk Agent — calendar store (SQLite via Prisma)
// See specs/001-voice-front-desk-agent/data-model.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Service {
  id          String    @id @default(cuid())
  name        String    @unique
  category    String    @default("Other")
  durationMin Int
  price       Int // minor units (cents)
  bookings    Booking[]
}

model Booking {
  id           String   @id @default(cuid())
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id])
  startTime    DateTime
  endTime      DateTime
  customerName String
  contact      String // phone number
  status       String   @default("confirmed") // 'confirmed' | 'cancelled'
  createdAt    DateTime @default(now())

  @@index([startTime, endTime])
  @@index([customerName, contact])
}

model FAQ {
  id     String @id @default(cuid())
  topic  String @unique
  answer String
}

model CallbackRequest {
  id           String   @id @default(cuid())
  customerName String
  contact      String
  reason       String
  createdAt    DateTime @default(now())
}
